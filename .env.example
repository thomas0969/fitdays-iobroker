# FitDays credentials - NEVER commit the real file
FITDAYS_EMAIL=user@example.com
FITDAYS_PASSWORD=change-me

# API locale
FITDAYS_REGION=eu
FITDAYS_COUNTRY=DE
FITDAYS_LANGUAGE=de

# Default rolling window for normal sync
FITDAYS_LOOKBACK_DAYS=7

# Shared output file read by ioBroker JavaScript
FITDAYS_OUTPUT=/opt/iobroker/fitdays-sync/fitdays-data.json
